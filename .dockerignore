# The build context. Everything here either does not belong in an image or is
# produced inside it — `COPY . .` must never bring a developer's node_modules,
# their vendor directory, or their .env along for the ride.

.git
.github
.idea
.vscode

node_modules
vendor
public/build
public/hot
public/storage

storage/app/public/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/testing/*
storage/framework/views/*
storage/logs/*
storage/pail

# Generated by Wayfinder during the build, never copied in.
resources/js/actions
resources/js/routes
resources/js/wayfinder

# Secrets never enter an image. The build uses .env.example and deletes it.
.env
.env.*
!.env.example

.phpunit.cache
.phpunit.result.cache
coverage
