# The build context. Everything here either does not belong in an image or is
# produced inside it — `COPY . .` must never bring a developer's node_modules,
# their vendor directory, or their .env along for the ride.

.git
.github
.idea
.vscode

node_modules
vendor
public/build
public/hot
public/storage

storage/app/public/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/testing/*
storage/framework/views/*
storage/logs/*
storage/pail
# Inertia's SSR devtools state, written by the Vite dev server. Local only.
storage/inertia-devtools

# Laravel regenerates these inside the image. Copying a developer's copies in
# ships their dev-only providers — `Laravel\Pail` for one — into an image
# built with `--no-dev`, which then fails to boot. Git ignores them too, so CI
# never sees the problem and only a local production build does.
bootstrap/cache/*.php

# Generated by Wayfinder during the build, never copied in.
resources/js/actions
resources/js/routes
resources/js/wayfinder

# Secrets never enter an image. The build uses .env.example and deletes it.
.env
.env.*
!.env.example

dump.rdb
.phpunit.cache
.phpunit.result.cache
coverage
