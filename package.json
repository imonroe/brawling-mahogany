{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/ tests/js/ *.ts *.js",
        "format:check": "prettier --check resources/ tests/js/ *.ts *.js",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "types:check": "vue-tsc --noEmit && tsc -p tsconfig.sw.json",
        "wayfinder": "php artisan wayfinder:generate --with-form",
        "check": "npm run wayfinder && npm run lint:check && npm run format:check && npm run types:check && npm run test"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tailwindcss/vite": "^4.1.11",
        "@types/node": "^22.13.5",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/eslint-config-typescript": "^14.3.0",
        "@vue/test-utils": "^2.4.11",
        "concurrently": "^10.0.3",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-vue": "^9.32.0",
        "jsdom": "^30.0.1",
        "prettier": "^3.4.2",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.23.0",
        "vite": "^8.0.0",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^4.1.11",
        "vue-tsc": "^2.2.4"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@inertiajs/vite": "^3.0.0",
        "@inertiajs/vue3": "^3.0.0",
        "@laravel/passkeys": "^0.2.0",
        "@lucide/vue": "^1.17.0",
        "@sentry/vue": "^10.70.0",
        "@tanstack/vue-table": "^9.1.2",
        "@vee-validate/zod": "^4.15.1",
        "@vueuse/core": "^12.8.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "laravel-vite-plugin": "^3.0.0",
        "reka-ui": "^2.9.8",
        "tailwind-merge": "^3.2.0",
        "tailwindcss": "^4.1.1",
        "tw-animate-css": "^1.2.5",
        "vee-validate": "^4.15.1",
        "vue": "^3.5.13",
        "vue-input-otp": "^0.3.2",
        "vue-sonner": "^2.0.0",
        "zod": "^3.25.76"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1",
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    }
}
