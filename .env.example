# Every key the application reads, with a safe placeholder.
#
# Copy this to .env and fill in a database password: that is the only value a
# new developer needs to boot the stack (issue #23). Everything with a real
# secret is empty here and stays empty in the repository — .env is gitignored,
# and no secret is ever baked into an image.
#
# See docs/Environment and secrets.md for which secrets exist in which
# environment, and how they are rotated.

APP_NAME="Brawling Mahogany"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# UTC storage, team-timezone display (PRD §9, Localisation).
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

# What Caddy serves. `:80` is plain HTTP and provisions no certificate, which
# is what a laptop wants. Staging and production set the real hostname —
# `staging.example.com` — and Caddy obtains and renews a certificate for it.
SERVER_NAME=:80

BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------------------
# `docker compose up` layers the local overrides on the shared base file.
COMPOSE_FILE=compose.local.yaml
APP_PORT=8000
APP_TLS_PORT=8443
VITE_PORT=5173
MAIL_UI_PORT=8025
DB_PORT_HOST=5432
REDIS_PORT_HOST=6379
# Which Dockerfile target the base compose file builds. Local overrides it.
APP_BUILD_TARGET=production
APP_IMAGE=brawling-mahogany:local
# Who the containers run as — every environment, not just this one. Locally the
# working tree is bind-mounted, so anything they write — Inertia's SSR devtools
# state, for one — appears in the repository owned by this user; set these to
# your own `id -u` and `id -g` if you are not 1000:1000, then `make build`.
# On a deploy target they are the service account the app runs as.
# Baked into the image, so changing them means rebuilding. Named APP_UID
# rather than UID because a shell already owns that name.
APP_UID=1000
APP_GID=1000
# Migrate on container start. True locally and in CI, where a fresh `up`
# should end with a migrated database; false on staging and production, where
# migrating is an explicit deploy step (docs/Deployment.md §2).
AUTO_MIGRATE=false

# ---------------------------------------------------------------------------
# Database — PostgreSQL
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=brawling_mahogany
DB_USERNAME=brawling_mahogany
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Cache, queue, session — Redis
# ---------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log

# Horizon's dashboard is authorised to super administrators only; this prefix
# keeps two environments sharing a Redis from showing each other's queues.
HORIZON_PREFIX=brawling_mahogany_horizon:
# Comma-separated. Only these addresses may open the Horizon dashboard, which
# shows queue payloads.
HORIZON_AUTHORIZED_EMAILS=

# ---------------------------------------------------------------------------
# Logging — structured JSON to stdout, no PII, ever (PRD §9)
# ---------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=stdout
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# Local: Mailpit, so no local send ever leaves the machine.
# Staging: SES in sandbox mode with MAIL_REDIRECT_TO set, so no test ever
#          reaches a real client (PRD §8.6).
# Production: SES, with SPF, DKIM, and DMARC on the sending subdomain.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Every outbound message is rewritten to this address when it is set. Staging
# sets it. Production must not.
MAIL_REDIRECT_TO=

# ---------------------------------------------------------------------------
# Storage — DigitalOcean Spaces, private, signed URLs
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
SENTRY_LARAVEL_DSN=
VITE_SENTRY_DSN="${SENTRY_LARAVEL_DSN}"
# Sample rates: everything in local, a slice of traffic in production.
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=false
# Sentry Logs are a separate pipeline from errors and breadcrumbs. Redaction
# for them is wired (config/sentry.php, before_send_log); leave this off until
# there is a reason to turn it on.
SENTRY_ENABLE_LOGS=false

# ---------------------------------------------------------------------------
# AI document intelligence (Slice 5) — configured now so the budget cap is
# never an afterthought (PRD §8.6)
# ---------------------------------------------------------------------------
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Hard monthly ceiling in whole dollars. Alerting fires against it; staging
# uses its own key with its own, much smaller cap.
AI_MONTHLY_BUDGET_USD=0

# ---------------------------------------------------------------------------
# Bug reporting (issue #176)
# ---------------------------------------------------------------------------
# The top bar's "Report a bug" button opens an n8n form in a modal; n8n turns
# the submission into a GitHub issue on this repository. The first users of
# this product have no GitHub accounts, and this is how they reach one.
#
# Two keys rather than one, so the button can be switched off during an n8n
# outage without losing the URL. `false`, `off`, `no` and `0` all switch it
# off — as does anything else not recognised as true, silently, because nothing
# is wrong with a switch that is off. `BUG_REPORT_ENABLED=enabled` is therefore
# off; write `true`.
#
# Two addresses are refused and treated as unset, each logged at most once an
# hour: one that is not http or https, and one on a host and port this
# application answers on — the frame is sandboxed `allow-scripts
# allow-same-origin`, which is not a sandbox at all against a same-origin
# document. n8n on its own port beside the app is fine; n8n proxied under the
# app's own hostname on the same port is not.
#
# NOTE: submissions become issues on a public repository. The dialog and the
# manual both warn against putting client details in one. See PRD §10.
BUG_REPORT_ENABLED=false
BUG_REPORT_URL=

# ---------------------------------------------------------------------------
# Web push (Slice 3)
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:hello@example.com"

VITE_APP_NAME="${APP_NAME}"
