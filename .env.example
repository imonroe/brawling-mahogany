# Every key the application reads, with a safe placeholder.
#
# Copy this to .env and fill in a database password: that is the only value a
# new developer needs to boot the stack (issue #23). Everything with a real
# secret is empty here and stays empty in the repository — .env is gitignored,
# and no secret is ever baked into an image.
#
# See docs/Environment and secrets.md for which secrets exist in which
# environment, and how they are rotated.

APP_NAME="Brawling Mahogany"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# UTC storage, team-timezone display (PRD §9, Localisation).
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

# What Caddy serves. `:80` is plain HTTP and provisions no certificate, which
# is what a laptop wants. Staging and production set the real hostname —
# `staging.example.com` — and Caddy obtains and renews a certificate for it.
SERVER_NAME=:80

BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------------------
# `docker compose up` layers the local overrides on the shared base file.
COMPOSE_FILE=compose.local.yaml
APP_PORT=8000
APP_TLS_PORT=8443
VITE_PORT=5173
MAIL_UI_PORT=8025
DB_PORT_HOST=5432
REDIS_PORT_HOST=6379
# Which Dockerfile target the base compose file builds. Local overrides it.
APP_BUILD_TARGET=production
APP_IMAGE=brawling-mahogany:local

# ---------------------------------------------------------------------------
# Database — PostgreSQL
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=brawling_mahogany
DB_USERNAME=brawling_mahogany
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Cache, queue, session — Redis
# ---------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log

# Horizon's dashboard is authorised to super administrators only; this prefix
# keeps two environments sharing a Redis from showing each other's queues.
HORIZON_PREFIX=brawling_mahogany_horizon:
# Comma-separated. Only these addresses may open the Horizon dashboard, which
# shows queue payloads.
HORIZON_AUTHORIZED_EMAILS=

# ---------------------------------------------------------------------------
# Logging — structured JSON to stdout, no PII, ever (PRD §9)
# ---------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=stdout
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# Local: Mailpit, so no local send ever leaves the machine.
# Staging: SES in sandbox mode with MAIL_REDIRECT_TO set, so no test ever
#          reaches a real client (PRD §8.6).
# Production: SES, with SPF, DKIM, and DMARC on the sending subdomain.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Every outbound message is rewritten to this address when it is set. Staging
# sets it. Production must not.
MAIL_REDIRECT_TO=

# ---------------------------------------------------------------------------
# Storage — DigitalOcean Spaces, private, signed URLs
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
SENTRY_LARAVEL_DSN=
VITE_SENTRY_DSN="${SENTRY_LARAVEL_DSN}"
# Sample rates: everything in local, a slice of traffic in production.
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=false

# ---------------------------------------------------------------------------
# AI document intelligence (Slice 5) — configured now so the budget cap is
# never an afterthought (PRD §8.6)
# ---------------------------------------------------------------------------
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Hard monthly ceiling in whole dollars. Alerting fires against it; staging
# uses its own key with its own, much smaller cap.
AI_MONTHLY_BUDGET_USD=0

# ---------------------------------------------------------------------------
# Web push (Slice 3)
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:hello@example.com"

VITE_APP_NAME="${APP_NAME}"
