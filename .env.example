# Every key the application reads, with a safe placeholder.
#
# Copy this to .env and fill in a database password: that is the only value a
# new developer needs to boot the stack (issue #23). Everything with a real
# secret is empty here and stays empty in the repository — .env is gitignored,
# and no secret is ever baked into an image.
#
# See docs/Environment and secrets.md for which secrets exist in which
# environment, and how they are rotated.

# APP_NAME is an **infrastructure identifier**, not the product's name. It is
# slugged into the session cookie, the cache prefix, the Redis prefix and the
# Horizon prefix, so changing it orphans those keyspaces and signs everybody
# out — which is why CLAUDE.md's rename note says to leave the codename here.
# What a person reads is APP_PRODUCT_NAME, below.
APP_NAME="Brawling Mahogany"
# The product's name, everywhere a human sees one: a browser tab, an
# invitation, the "via Goldieflow" half of a client-facing From line.
APP_PRODUCT_NAME="Goldieflow"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# UTC storage, team-timezone display (PRD §9, Localisation).
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

# What Caddy serves. `:80` is plain HTTP and provisions no certificate, which
# is what a laptop wants. Staging and production set the real hostname —
# `staging.example.com` — and Caddy obtains and renews a certificate for it.
SERVER_NAME=:80

# Who may claim, via `X-Forwarded-Proto`, that the request arrived over HTTPS.
# Empty is correct for the documented topology, where Caddy above terminates
# TLS in the app's own container with nothing in front of it.
#
# Set it only when a reverse proxy does terminate TLS instead — otherwise
# Laravel reads the scheme as `http`, writes `http://` asset URLs into an
# `https://` page, and the browser blocks them as mixed content. Give the
# proxy's address or network (comma-separated), never `*`: Docker publishes
# the app's port around ufw, so the container answers from outside the proxy
# too, and a wildcard lets anyone forge `X-Forwarded-For` and defeat the
# per-IP throttle on password reset.
TRUSTED_PROXIES=

BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------------------
# `docker compose up` layers the local overrides on the shared base file.
COMPOSE_FILE=compose.local.yaml
APP_PORT=8000
APP_TLS_PORT=8443
VITE_PORT=5173
MAIL_UI_PORT=8025
DB_PORT_HOST=5432
REDIS_PORT_HOST=6379
# Which Dockerfile target the base compose file builds. Local overrides it.
APP_BUILD_TARGET=production
APP_IMAGE=brawling-mahogany:local
# Who the containers run as — every environment, not just this one. Locally the
# working tree is bind-mounted, so anything they write — Inertia's SSR devtools
# state, for one — appears in the repository owned by this user; set these to
# your own `id -u` and `id -g` if you are not 1000:1000, then `make build`.
# On a deploy target they are the service account the app runs as.
# Baked into the image, so changing them means rebuilding. Named APP_UID
# rather than UID because a shell already owns that name.
APP_UID=1000
APP_GID=1000
# Migrate on container start. True locally and in CI, where a fresh `up`
# should end with a migrated database; false on staging and production, where
# migrating is an explicit deploy step (docs/Deployment.md §2).
AUTO_MIGRATE=false

# ---------------------------------------------------------------------------
# Database — PostgreSQL
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=brawling_mahogany
DB_USERNAME=brawling_mahogany
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Cache, queue, session — Redis
# ---------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log

# Horizon's dashboard is authorised to super administrators only; this prefix
# keeps two environments sharing a Redis from showing each other's queues.
HORIZON_PREFIX=brawling_mahogany_horizon:
# Comma-separated. Only these addresses may open the Horizon dashboard, which
# shows queue payloads.
HORIZON_AUTHORIZED_EMAILS=

# ---------------------------------------------------------------------------
# Logging — structured JSON to stdout, no PII, ever (PRD §9)
# ---------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=stdout
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# Local: Mailpit, so no local send ever leaves the machine.
# Staging: SES with MAIL_REDIRECT_TO set, so no test reaches a real client
#          (PRD §8.6). Since #12 put the account into production access this is
#          the only account-wide guard: SES no longer refuses unverified
#          recipients, and leaving this empty sends mail to its real
#          recipient with no warning (#196).
# Production: SES over SMTP, from the verified identity below.
#
# The verified sending domain is `monroedigitalconsulting.com` and the
# identity is `goldieflow@monroedigitalconsulting.com` (#12). Two things
# about that are worth knowing before you change either:
#
#   * On staging and production MAIL_FROM_ADDRESS must be an identity SES is
#     authorised to send as — `goldieflow@monroedigitalconsulting.com`. SES
#     rejects the call outright for an unverified one, and a From the message is
#     not DKIM-aligned with fails DMARC — which for this product is the same
#     failure as not sending, except that nobody finds out. (Not SPF: that is
#     evaluated against the envelope MAIL FROM, not this header.) A team's own
#     address rides in **Reply-To**, never here (PRD §8.5).
#   * **Locally it can be anything**, and the default below deliberately is:
#     nothing local leaves the machine, and a developer's `.env` seeded with the
#     production identity is the file that gets copied to a server. `Environment
#     and secrets.md` §2 is the authority on the per-environment values.
#   * MAIL_FROM_NAME is only the fallback for messages the product itself
#     writes. A client-facing message overrides it with the team's name — see
#     `App\Support\Mail\SendingIdentity`.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="goldieflow@localhost.test"
MAIL_FROM_NAME="${APP_PRODUCT_NAME}"
# Every outbound message is rewritten to this address when it is set. Staging
# sets it. Production must not.
MAIL_REDIRECT_TO=

# The SNS topic SES publishes bounce and complaint notifications to (#95).
#
# **Not optional in production, and the webhook refuses everything while it is
# empty.** A valid Amazon signature only proves *some* SNS topic sent a
# message — anybody with an AWS account can create one and point it at
# /webhooks/ses, and its notifications are signed exactly as genuinely as ours.
# This is what makes the signature check mean *our* topic.
#
# The endpoint writes to the suppression list, which binds every team on the
# platform, so the failure mode of getting this wrong is a stranger being able
# to stop this product writing to any address they choose. Empty is the safe
# default and refuses rather than accepts.
#
# Locally it stays empty: nothing sends through SES, so nothing bounces.
SES_SNS_TOPIC_ARN=

# ---------------------------------------------------------------------------
# Storage — DigitalOcean Spaces, private, signed URLs
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
SENTRY_LARAVEL_DSN=
VITE_SENTRY_DSN="${SENTRY_LARAVEL_DSN}"
# Sample rates: everything in local, a slice of traffic in production.
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=false
# Sentry Logs are a separate pipeline from errors and breadcrumbs. Redaction
# for them is wired (config/sentry.php, before_send_log); leave this off until
# there is a reason to turn it on.
SENTRY_ENABLE_LOGS=false

# ---------------------------------------------------------------------------
# AI document intelligence (Slice 5) — configured now so the budget cap is
# never an afterthought (PRD §8.6)
# ---------------------------------------------------------------------------
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Hard monthly ceiling in whole dollars. Alerting fires against it; staging
# uses its own key with its own, much smaller cap.
AI_MONTHLY_BUDGET_USD=0

# ---------------------------------------------------------------------------
# Bug reporting (issue #176)
# ---------------------------------------------------------------------------
# The top bar's "Report a bug" button opens an n8n form in a modal; n8n turns
# the submission into a GitHub issue on this repository. The first users of
# this product have no GitHub accounts, and this is how they reach one.
#
# Two keys rather than one, so the button can be switched off during an n8n
# outage without losing the URL. `false`, `off`, `no` and `0` all switch it
# off — as does anything else not recognised as true, silently, because nothing
# is wrong with a switch that is off. `BUG_REPORT_ENABLED=enabled` is therefore
# off; write `true`.
#
# Two addresses are refused and treated as unset, each logged at most once an
# hour: one that is not http or https, and one on a host and port this
# application answers on — the frame is sandboxed `allow-scripts
# allow-same-origin`, which is not a sandbox at all against a same-origin
# document. n8n on its own port beside the app is fine; n8n proxied under the
# app's own hostname on the same port is not.
#
# NOTE: submissions become issues on a public repository. The dialog and the
# manual both warn against putting client details in one. See PRD §10.
BUG_REPORT_ENABLED=false
BUG_REPORT_URL=

# ---------------------------------------------------------------------------
# Web push (Slice 3)
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:hello@example.com"

# ---------------------------------------------------------------------------
# Extract — reading dates and tasks out of documents (Slice 5)
# ---------------------------------------------------------------------------
#
# `null` is the default and it **refuses every call**, deliberately. PRD §10
# lists four things that must exist before F10 ships — a signed data processing
# agreement, a provider contractually barred from training on submitted
# content, a retention position, and disclosure language in the team's own
# listing agreement (#13). None of them is a code change and none of them can
# be checked from inside the application. A default that reached a live
# provider would turn the *absence* of that decision into a decision: somebody
# else's contract goes to a third party because a key was never set.
#
# Set this to `anthropic` only once those four exist.
EXTRACTION_DRIVER=null
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-sonnet-5

# Generous, because this runs in a queue worker rather than in front of
# somebody. Several pages of contract through a vision model is genuinely slow,
# and a timeout that fires mid-read costs the money *and* produces nothing.
#
# **Raising this raises two other numbers with it.** `RunDocumentExtraction`
# derives its own job timeout from this value, so the worker outlasts the call;
# `REDIS_QUEUE_RETRY_AFTER` has to stay above *that*, or Redis hands the same
# row to a second worker while the first is still reading it.
# `tests/Unit/Extraction/ExtractionTimeoutsTest.php` fails when the three fall
# out of order.
EXTRACTION_TIMEOUT=180

# The queue's visibility window, which has to stay above the job timeout above
# — otherwise Redis hands the same extraction to a second worker while the
# first is still reading it.
#
# Left unset it **derives** from EXTRACTION_TIMEOUT, so raising that raises this
# too. Set it only to widen the margin, never to narrow it below
# EXTRACTION_TIMEOUT + 60.
# REDIS_QUEUE_RETRY_AFTER=

# The spend caps, in **micros** — millionths of a dollar. Not cents: a page of
# contract costs a fraction of one, so a cap in cents cannot express the
# figures it is capping. 50,000,000 is $50; 500,000,000 is $500.
#
# Two ceilings, because they fail differently. The team cap is a commercial
# limit and one team hitting it must not stop anybody else. The platform cap
# exists so a defect — a retry loop, a runaway import — cannot spend the
# company's money overnight, and it stops everything by design.
#
# PRD §8.6 asks staging to run a **separate provider key with its own budget
# cap**. That is these two variables, set lower, against a key that is not
# production's.
#
# **Zero is a ceiling of zero — it stops everything. A negative number is the
# absence of a ceiling.** They are not interchangeable and the wrong reading is
# expensive in one direction: `> 0` treats a deliberate stop as "unlimited".
# Note what that means for a typo — `(int) env()` of an unparseable value is
# `0`, so a mistyped cap **stops extraction** rather than uncapping it. That is
# the safe direction, and it is worth knowing rather than discovering.
EXTRACTION_TEAM_MONTHLY_CAP=50000000
EXTRACTION_PLATFORM_MONTHLY_CAP=500000000
EXTRACTION_CAP_WARN_PERCENT=80

VITE_APP_NAME="${APP_PRODUCT_NAME}"
